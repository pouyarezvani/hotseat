{
	"name": "hotseat",
	"version": "0.1.0",
	"description": "Keep several Claude Code and Codex accounts on one Mac, see how much of each limit is left in the menu bar, and switch automatically when the one in use runs out.",
	"license": "MIT",
	"type": "module",
	"bin": {
		"hotseat": "./bin/hotseat.ts"
	},
	"files": [
		"bin",
		"src",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"bun": ">=1.2"
	},
	"scripts": {
		"dev": "bun run bin/hotseat.ts",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write .",
		"build": "bun build bin/hotseat.ts --compile --outfile dist/hotseat"
	},
	"keywords": [
		"claude-code",
		"codex",
		"account-switcher",
		"rate-limit",
		"cli"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/pouyarezvani/hotseat"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"@types/bun": "latest",
		"typescript": "^5.9.0"
	}
}
